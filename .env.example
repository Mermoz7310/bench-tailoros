# Copier en .env.local (jamais commité). Valeurs locales : `npx supabase status -o env`.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Stripe (optionnel : sans ces 3 variables, la facturation est désactivée proprement) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=

# --- E-mails (optionnel : sans clé, les e-mails sont affichés dans les logs) ---
RESEND_API_KEY=
EMAIL_FROM=SaaS <no-reply@example.com>
